# Production/runtime connection: Neon pooled connection string.
# Set this value in Vercel/Netlify Environment Variables; never commit the real password.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional: direct Neon connection for `npx drizzle-kit push` from a trusted workstation/CI.
# Do not use the direct URL as the runtime URL in serverless production.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional connection pool size per serverless instance (default: 2).
PG_POOL_MAX=2
